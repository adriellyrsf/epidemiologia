"14 a 18 anos",
"19 a 28 anos",
"29 a 38 anos",
"39 a 48 anos",
"49 a 58 anos",
"59 a 68 anos",
"69 a 78 anos",
"79 a 99 anos",
"Não informado"
)
)
ggplot(dados, aes(x = faixa, fill = faixa)) +
geom_bar(width = 0.7, color = "black") +
labs(
title = "Frequência de suicídio segundo a faixa etária",
x = "Faixa Etária",
y = "Número de Óbitos"
) +
scale_fill_viridis_d(option = "magma") +
theme_minimal(base_size = 14) +
theme(
plot.title = element_text(face = "bold", hjust = 0.5),
axis.text.x = element_text(angle = 45, hjust = 1),
legend.position = "none"
)

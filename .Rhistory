dados_limpos <- subset(dados, OCUP != "IGNORADA")
top10 <- sort(table(dados_limpos$OCUP), decreasing = TRUE)[1:10]
top10_df <- data.frame(
Profissao = names(top10),
Frequencia = as.numeric(top10)
)
ggplot(top10_df,
aes(x = reorder(Profissao, Frequencia),
y = Frequencia,
fill = Frequencia)) +
geom_bar(stat = "identity", width = 0.7, color = "black") +
coord_flip() +
labs(
title = "Top 10 profissões com maior número de óbitos (2010–2019)",
x = "Profissão",
y = "Número de Óbitos"
) +
scale_fill_viridis_c(option = "magma") +
theme_minimal(base_size = 14) +
theme(
plot.title = element_text(face = "bold", size = 16, hjust = 0.5),
axis.title = element_text(face = "bold"),
legend.position = "none",
panel.grid.major.y = element_blank(),
panel.grid.minor = element_blank()
)
